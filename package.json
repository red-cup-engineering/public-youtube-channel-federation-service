    "@red-cup-engineering/a2a-contracted-agent-service": "^0.12.0",
    "@red-cup-engineering/computer-serialized-content-engineering-services-section": "^0.6.2",
    "@red-cup-engineering/computer-text-content-engineering-services-section": "^0.1.3",
